<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is disabled in Release.
	     Reason: the app spawns a bundled Chromium child for CDP scraping +
	     identify flows. Under App Sandbox the spawned Chromium inherits the
	     parent's narrow sandbox profile, hits SIGABRT in its main thread
	     during early init (codeSigningMonitor:2, abort() in Chromium Framework,
	     no usable Chrome console output), and never binds its CDP port —
	     observed deterministically in v0.14.x even with Hardened Runtime
	     entitlements (allow-jit + disable-library-validation + allow-unsigned-
	     executable-memory) set on BOTH the outer .app and the nested
	     Chromium.app. The known cure is to not sandbox the outer app; this
	     forfeits Mac App Store eligibility, which is already deferred per
	     docs/app-store.md. Hardened Runtime remains on for notarization. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- v0.21.89: restore native membership of our existing shared folder.
	     v0.21.31 removed BOTH app groups and keychain-access-groups after
	     AMFI -413. That experiment did not isolate which needed a profile.
	     Apple documents that TEAM-ID-prefixed macOS app groups do NOT need
	     provisioning; group.-prefixed groups and Keychain Access Groups do.
	     A Developer-ID signed, profile-free probe with ONLY this group ran
	     and read all seven saved readings on macOS 27.2.1 (2026-11-15).
	     Without membership, macOS 15+ protects even an unsandboxed host's
	     own Group Container and may ask for other-app-data access.
	     Keep keychain-access-groups absent: KeychainHelper falls back to
	     the existing default access group. Do not change the group ID.
	     https://developer.apple.com/documentation/xcode/accessing-app-group-containers -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>T34G959ZG8.group.com.ethansk.macos-widgets-stats-from-website</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Hardened Runtime exceptions required to spawn the bundled Chromium child.
	     Chromium's V8 needs JIT-able pages (allow-jit + allow-unsigned-executable-memory),
	     and its frameworks are signed by Google's team identity so dyld must skip
	     library validation when our sandboxed parent process loads them.
	     Without these three, the spawned Chromium quits immediately and CDP never binds.
	     See scripts/embed-chromium.sh for the corresponding nested-bundle entitlements. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
